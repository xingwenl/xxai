# 日志相关
# 本地直接运行后端时的日志路径（相对路径按 apps/backend 解析）；
# Docker 部署由根目录 docker-compose.yml 按服务覆盖为 /app/logs/{api,worker,wechat-bot}/app.log
LOG_FILE_PATH=logs/app.log
# 每个服务日志目录内保留最近 N 天的 app-<日期>.log
LOG_FILE_BACKUP_COUNT=14

# JWT_SECRET_KEY=your_jwt_secret_key 登录过期时间 60*24*1 1天 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_GENERATION_TIMEOUT_SECONDS=120
IMAGE_MAX_BYTES=26214400
IMAGE_MAX_COUNT=4

# 主对话模型（未绑定模型注册表时的全局默认）；API Key 走上面的 OPENAI_API_KEY
# OpenCode Zen Go 示例：OpenAI 兼容端点为 https://opencode.ai/zen/go/v1
# 仅支持走 /v1/chat/completions 的模型，例如 glm-5.2 / kimi-k2.6 / deepseek-v4-pro
# MODEL_DEFAULT_BASE_URL=https://opencode.ai/zen/go/v1
# MODEL_DEFAULT_NAME=glm-5.2
MODEL_DEFAULT_BASE_URL=
MODEL_DEFAULT_NAME=
