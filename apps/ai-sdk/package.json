{
  "name": "xxai-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Agent JS SDK",
  "author": "",
  "license": "MIT",
  "main": "./dist/xxai-agent.umd.cjs",
  "module": "./dist/xxai-agent.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/xxai-agent.es.js",
      "require": "./dist/xxai-agent.umd.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/xxai-agent.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "sdk",
    "vue",
    "websocket"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "verify-package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && npm run verify-package",
    "preview": "vite preview",
    "demo": "cd demo && npx serve -l 5174"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "5.4.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^1.8.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0"
  }
}
