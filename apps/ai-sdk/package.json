{
  "name": "xxai-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Agent JS SDK",
  "author": "",
  "license": "MIT",
  "main": "./dist/xxai-agent.umd.js",
  "module": "./dist/xxai-agent.es.js",
