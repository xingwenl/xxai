VITE_CLERK_PUBLISHABLE_KEY=
# 后端 API 前缀，业务请求使用相对路径，例如 /auth/login
VITE_API_URL=/api/v1
# 悬浮助手使用哪个 Embed Client：默认从后端签发的 Embed token 的 client_id claim 自动解析，
# 只有「一个前端同时接多个 Client」时才需要显式覆盖。
# 切换智能体入口还要求后台开启该 Client 的「允许切换智能体」开关。
# VITE_AGENT_CLIENT_ID=
VITE_AGENT_PLATFORM_ID=2
VITE_AGENT_ID=1
# Optional: defaults to the same-origin WebSocket proxy.
# VITE_AGENT_WS_URL=ws://localhost:8080/api/v1/ws/agents/1
VITE_WS_URL=http://localhost:3003
