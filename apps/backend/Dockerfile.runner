FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir fastapi==0.139.2 uvicorn==0.51.0 pydantic==2.13.4 \
    && useradd --create-home --uid 10001 runner

COPY runner ./runner
COPY skill_runner_protocol.py ./skill_runner_protocol.py

USER runner

EXPOSE 8090

CMD ["uvicorn", "runner.main:app", "--host", "0.0.0.0", "--port", "8090"]
