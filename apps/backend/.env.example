# 店铺运营平台（hua8）接入：store_ops_query 工具与 shop-agent 会话
STORE_OPS_BASE_URL=http://hua8.bbtree.xyz
STORE_OPS_REDIS_TTL_SECONDS=43200
STORE_OPS_HTTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# 本文件是「宿主机直接跑 apps/backend」时的示例配置（`apps/backend/.env` 的模板）。
# 走 docker compose 时以**仓库根目录的 .env** 为准（见根 .env.example 与
# docker-compose.yml 的 x-backend-environment）：那份决定容器里的 DB_HOST=db、
# AGENT_FILE_STORAGE_PATH=/app/storage 等，和这份可以不一样，也正是最容易漂移的
# 地方——所以下面的值都只写占位符，请按本机实际情况填写。
#
# 只填下面这些就能登录控制台并跑通种子脚本；其余配置项都有代码内默认值，
# 需要时再照 app/core/config.py 的 os.getenv 名称补。
# ---------------------------------------------------------------------------

APP_ENV=development

# 数据库：本机直跑指向 127.0.0.1（compose 起的 db 已把 5432 映射到宿主机）。
# 也可以只写 DATABASE_URL，它的优先级高于下面这组 DB_*。
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_base
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_base

# Redis：配额计数与网关事件回放流都在这上面（DB 0）。
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# 文件存储根目录：技能包解压目录、附件、知识库上传件都落在它下面。
# 不写就是 apps/backend/storage（代码内默认值走绝对路径）；写了就用写的值，
# 相对路径按进程工作目录解析，所以本机直跑请写绝对路径。compose 里被覆盖成
# /app/storage，与宿主机同一个目录。
# AGENT_FILE_STORAGE_PATH=/abs/path/to/apps/backend/storage

# 加密 Agent 版本 api_key 与 MCP 认证头的密钥。上线前必须换成随机值，
# 且换掉之后旧数据无法解密。
AGENT_MASTER_KEY=dev-agent-master-key-change-me

# 登录与控制台 JWT。
JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 主对话模型：不绑定模型注册表时的全局默认；API Key 走 OPENAI_API_KEY。
MODEL_DEFAULT_NAME=deepseek-v4-flash
MODEL_DEFAULT_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 嵌入通道（第三方页面嵌 SDK / iframe 用）。DB_* 清库后这里的 client_id 会失效：
# 开发环境由 scripts/seed_dev_env.py 按 EMBED_CLIENT_ID 重建同名客户端，
# 所以清库前后保持一致即可，不要在这里写真实生产凭据。
EMBED_CLIENT_ID=
EMBED_CLIENT_SECRET=
EMBED_AGENT_ID=0
EMBED_ORIGIN=http://localhost:5173

# 配额（四维：发 token / 建连接 / 发消息 / 模型 token）。默认只在 production 打开；
# 开发环境打开会强制依赖 Redis，清库时记得一并 FLUSHDB（reset_dev_db.sh 会做）。
QUOTA_ENABLED=false
